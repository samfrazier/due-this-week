{
  "manifest_version": 2,
  "name": "Due This Week: To-Do Sidebar for Canvas LMS",
  "description": "Free, private weekly to-do sidebar for Canvas, Blackboard, and D2L Brightspace. Unofficial; not affiliated with Instructure.",
  "version": "1.0.1",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Due This Week",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    }
  },
  "content_security_policy": "script-src 'self'; object-src 'self'",
  "permissions": ["storage"],
  "background": {
    "scripts": ["background.bundle.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["contentScript.bundle.js"],
      "css": ["content.styles.css"],
      "all_frames": true
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true,
    "browser_style": true,
    "chrome_style": false
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "due-this-week@samfrazier.github.io"
    }
  }
}
